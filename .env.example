# PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Meta Muse (Model API) — proof verification
# Get a key: https://dev.meta.ai/ → API keys → Create API key
# Keys look like: LLM_....
MODEL_API_KEY=
# Optional aliases / overrides:
# MUSE_API_KEY=
# MUSE_MODEL=muse-spark-1.3
# MUSE_BASE_URL=https://api.meta.ai/v1

# Set to "true" to force mock PayPal even if credentials exist
PAYPAL_MOCK=false

# PayPal webhook ID from Developer Dashboard → Webhooks (required in production)
PAYPAL_WEBHOOK_ID=
# Local-only escape hatch — never enable on Vercel
# PAYPAL_WEBHOOK_ALLOW_UNSIGNED=true

# Comma-separated emails allowed to hit /api/admin/* (and gated admin UI).
# Local/dev seed creates umer@umer.com — include it here after `npm run db:seed`.
# If unset, any signed-in user may access admin APIs.
ADMIN_EMAILS=umer@umer.com
# Optional production seed gate header x-admin-seed-key
# ADMIN_SEED_KEY=

# App URL (for absolute links in demos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Neon Postgres (from `vercel integration add neon` + `vercel env pull`)
# Pooled URL for the app; unpooled for prisma migrate/db push (directUrl).
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Better Auth + Passkeys
BETTER_AUTH_SECRET=generate_a_long_random_string
BETTER_AUTH_URL=http://localhost:3000

# Email verification (password signup) — Resend
# Required in production so users receive the verify link after signup.
# Marketplace: accept Resend terms, then `vercel integration add resend`
#   --billing-plan free --meta region=us-east-1 --meta domain=<verified-domain>
# Or create a key at https://resend.com → API Keys and set it on Vercel.
# Without this key, signup still creates an unverified user + token; the link is
# logged server-side and /verify-email UI works, but no inbox delivery.
RESEND_API_KEY=
# Optional From address (default: PayWhenDone <onboarding@resend.dev>)
# RESEND_FROM_EMAIL=PayWhenDone <onboarding@resend.dev>
# EMAIL_FROM=PayWhenDone <onboarding@resend.dev>
